{
  "name": "trazim",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "set -a && . ./.env.local && set +a && supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" --schema public > src/lib/supabase/database.types.ts",
    "db:seed:generate": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-seed.ts",
    "test:db": "pnpm db:seed:generate && node supabase/tests/db.test.mjs",
    "db:demo": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/demo-data.ts",
    "test:e2e": "node tests/e2e/panel.test.mjs && node tests/e2e/reviews-admin.test.mjs",
    "admin:set": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/set-admin.ts",
    "test:seo": "node tests/e2e/seo.test.mjs",
    "db:content": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-service-content.ts",
    "db:cities": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sync-cities.ts",
    "db:wipe": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/wipe-businesses.ts",
    "db:import": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/import-businesses.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.1",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-intl": "^4.14.7",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sharp": "0.35.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "puppeteer-core": "^25.12.0",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.0"
}
