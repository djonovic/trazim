# Public site URL (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/revalidate (any long random string)
REVALIDATE_SECRET=

# SEO (optional): Search Console / Bing Webmaster / Yandex ownership tokens
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
# IndexNow (Bing, Yandex): any 8–128 char hex/alnum string; served at /indexnow-key.txt
INDEXNOW_KEY=
